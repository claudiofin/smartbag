# ── Generated artefacts, all reproducible from the scripts ───────────────────
# Geometry: cad/bag_and_insert.py rebuilds every STL in ~6 s, and
# tools/pipeline.sh re-exports smartbag_core.glb from the board.
cad/stl/

# Animation frames: ~2 GB of PNG. tools/render_animation.sh rebuilds them
# (~26 min), render/build_video.py turns them into the films. The finished
# films ARE committed, under media/.
render/anim/

# ── KiCad session state ─────────────────────────────────────────────────────
# ⚠️ .kicad_pro is NOT ignored any more. It used to be a file KiCad wrote by
# itself, holding nothing but local settings. It now carries the design rules —
# 0.1 mm lines, 0.3/0.15 vias, 0.05 mm mask web — and without it kicad-cli
# judges the board against a generic 0.2 mm process and reports 220 violations
# that say nothing about the layout. It is generated by generate_schematic.py
# and it is part of the design.
hardware/*.kicad_prl
hardware/*-backups/
hardware/*-bak/
fp-info-cache

# ── Machine learning ────────────────────────────────────────────────────────
# 1650 renders, ~9 MB, rebuilt in ~12 min by ml/render_dataset.py.
ml/dataset/

# ── Firmware build output ───────────────────────────────────────────────────
# ⚠️ app/vectors.json is NOT ignored, although it is generated. It is the golden
# payload set the phone-side tests run against, and committing it means a
# contributor with no C toolchain can still run app/test_protocol.mjs and see
# whether the two halves agree. `make -C firmware vectors` regenerates it.
firmware/test_smartbag
firmware/test_sb_fsr
firmware/test_sb_ble
firmware/gen_vectors
*.o

# ── Blender / CAD scratch ───────────────────────────────────────────────────
*.blend
*.blend[0-9]
*.step
*.stpz

# ── Environments and editors ────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
.vscode/
.idea/
.claude/
.DS_Store

# ── RF ──────────────────────────────────────────────────────────────────────
# S11 traces, regenerated by rf/patch_sim.py in about a minute each.
rf/s11_*.csv
