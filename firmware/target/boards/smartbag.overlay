/* GENERATED by hardware/generate_pinmap.py — do not edit.
 *
 * The board, as Zephyr needs to hear it. Every pin below is netlist.py's and
 * every charge threshold is the cell's own datasheet, via hardware/bom.py.
 *
 * ⚠️ This overlays the nRF54L15 DK, which is the only nRF54L15 board that can be
 * bought today. The SmartBag board is the same silicon with a different pin map,
 * and that pin map is what this file is.
 */

&pinctrl {
    spi00_default: spi00_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
                    <NRF_PSEL(SPIM_MOSI, 2, 2)>,
                    <NRF_PSEL(SPIM_MISO, 2, 4)>;
        };
    };

    i2c20_default: i2c20_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 1)>;
            bias-pull-up;
        };
    };
};

&spi00 {
    status = "okay";
    pinctrl-0 = <&spi00_default>;
    pinctrl-names = "default";
    /* ⚠️ No cs-gpios: there are three devices on this bus and one CSN pin, so
     * the selects are plain GPIOs driven by sb_hal_zephyr.c. */
};

&i2c20 {
    status = "okay";
    pinctrl-0 = <&i2c20_default>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_FAST>;

    npm1300: pmic@6b {
        compatible = "nordic,npm1300";
        reg = <0x6b>;

        npm1300_charger: charger {
            compatible = "nordic,npm1300-charger";
            /* From Jauch LP523450JU: 4.2 V termination, 1.0 C = 1000 mA. */
            term-microvolt = <4200000>;
            current-microamp = <1000000>;
            /* ⛔ The cell's own bands, not lithium's in general. */
            dischg-limit-microamp = <1000000>;
            vbus-limit-microamp = <500000>;
            thermistor-ohms = <10000>;
            thermistor-beta = <3435>;
            thermistor-cold-millidegrees = <0>;
            thermistor-cool-millidegrees = <15000>;
            thermistor-warm-millidegrees = <45000>;
            thermistor-hot-millidegrees = <55000>;
            charging-enable;
        };
    };

    imu@68 {
        compatible = "bosch,bmi270";
        reg = <0x68>;
        irq-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
    };

    tof@29 {
        compatible = "st,vl53l1x";
        reg = <0x29>;
        xshut-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        int-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;   /* ADC0, P1.04 */
        zephyr,resolution = <12>;
    };

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN1>;   /* ADC1, P1.05 */
        zephyr,resolution = <12>;
    };

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;   /* ADC2, P1.06 */
        zephyr,resolution = <12>;
    };

    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>;   /* ADC3, P1.07 */
        zephyr,resolution = <12>;
    };

    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN4>;   /* ADC4, P1.11 */
        zephyr,resolution = <12>;
    };

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;   /* ADC5, P1.12 */
        zephyr,resolution = <12>;
    };
};
